datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. USUARIOS Y AUTENTICACIÓN (Auth.js para clientes y panel admin)
// =========================================================================

model User {
  id            String    @id @default(cuid()) // Identificador único de usuario
  name          String?                        // Nombre y apellido
  email         String?   @unique              // Correo electrónico (único para login)
  emailVerified DateTime?                      // Fecha de verificación de email
  password      String?                        // Contraseña cifrada (para login con usuario/clave)
  phone         String?                        // Teléfono de contacto / WhatsApp
  role          String    @default("CUSTOMER") // Rol: "ADMIN" (dueños) o "CUSTOMER" (clientes)
  
  accounts      Account[]                      // Cuentas vinculadas (Google, etc.)
  sessions      Session[]                      // Sesiones activas del usuario
  orders        Order[]                        // Historial de pedidos que realizó este usuario

  createdAt     DateTime  @default(now())      // Fecha de registro
  updatedAt     DateTime  @updatedAt          // Fecha de última modificación
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================================================
// 2. CATÁLOGO: RUBROS, SUBRUBROS Y MARCAS (Administrados en el E-commerce)
// =========================================================================

model Category {
  id            String        @id @default(cuid()) // ID único del rubro en el e-commerce
  name          String                             // Nombre visible (ej: "Limpieza y Químicos", "Piscinas")
  slug          String        @unique              // Texto amigable para la URL (ej: "limpieza-y-quimicos")
  imageUrl      String?                            // Foto o icono de portada del rubro (opcional)
  order         Int           @default(0)          // Orden de aparición en el menú de la tienda
  isActive      Boolean       @default(true)       // true = visible en la tienda; false = oculto

  // Código opcional para escalar a futuro si Apollo habilita la tabla de rubros (ARUB / RCod):
  erpCode       String?       @unique              // Ej: "01". Mientras sea null, se gestiona 100% desde la web

  subCategories SubCategory[]                      // Subrubros que dependen de este rubro
  products      Product[]                          // Productos asignados a este rubro

  createdAt     DateTime      @default(now())      // Fecha de creación
  updatedAt     DateTime      @updatedAt           // Fecha de última modificación
}

model SubCategory {
  id         String    @id @default(cuid()) // ID único del subrubro en el e-commerce
  name       String                         // Nombre visible (ej: "Cloros", "Desengrasantes")
  slug       String                         // Texto amigable para la URL (ej: "cloros")
  order      Int       @default(0)          // Orden de aparición dentro del rubro
  isActive   Boolean   @default(true)       // true = visible en la tienda; false = oculto

  // Código opcional para escalar a futuro si Apollo habilita la tabla de subrubros (ASUB / SCod):
  erpCode    String?   @unique              // Ej: "0101". Mientras sea null, se gestiona 100% desde la web

  categoryId String                         // ID del rubro padre al que pertenece
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]                      // Productos asignados a este subrubro

  createdAt  DateTime  @default(now())      // Fecha de creación
  updatedAt  DateTime  @updatedAt           // Fecha de última modificación

  @@unique([categoryId, slug])              // Evita slugs repetidos dentro de un mismo rubro
}

model Brand {
  id        String    @id @default(cuid()) // ID único de la marca en el e-commerce
  name      String                         // Nombre visible (ej: "Higiene Uruguay", "Spartan")
  slug      String    @unique              // Texto amigable para la URL (ej: "higiene-uruguay")
  logoUrl   String?                        // Logo opcional de la marca
  isActive  Boolean   @default(true)       // true = visible en filtros; false = oculta

  // Código opcional para escalar a futuro si Apollo habilita la tabla de marcas (AMAR / MCod):
  erpCode   String?   @unique              // Ej: "0001". Mientras sea null, se gestiona 100% desde la web

  products  Product[]                      // Productos pertenecientes a esta marca

  createdAt DateTime  @default(now())      // Fecha de creación
  updatedAt DateTime  @updatedAt           // Fecha de última modificación
}

// =========================================================================
// 3. CATÁLOGO: PRODUCTOS
// =========================================================================

model Product {
  id                String         @id @default(cuid()) // ID único web del producto

  // --- Datos Comerciales Visibles en la Web ---
  name              String                              // Nombre comercial (en sincronización viene de ADES)
  slug              String         @unique              // URL amigable (ej: "lavandina-premium-5-lts")
  description       String?        @db.Text             // Descripción comercial del producto
  usageInstructions String?        @db.Text             // Modo de uso / instrucciones de dilución
  warnings          String?        @db.Text             // Advertencias y precauciones de seguridad
  suitableSurfaces  String?        @db.Text             // Superficies aptas donde se puede aplicar
  price             Float                               // Precio final de venta directo desde AVENTA (sin cálculos extra)
  compareAtPrice    Float?                              // Precio anterior tachado (opcional, para mostrar ofertas en la web)
  unit              String?                             // Presentación o contenido (ej: "Bidón 5L", "2 Lts", "Pack x 3")
  imageUrl          String?                             // Foto principal del producto (alojada en Supabase Storage)

  // --- Identificadores del ERP Local (Para sincronizar sin duplicar) ---
  sku               String?        @unique              // Código único en Apollo (viene de ACOD, ej: "0100003")
  barcode           String?                             // Código de barras (viene de ABARRA)

  // --- Códigos crudos de Apollo (Solo referencia / escalabilidad futura) ---
  // Guardan el ID que viene en Stock_Articulo sin sobrescribir la clasificación elegida en la web:
  erpRubroCode      String?                             // Código crudo ARUB de Stock_Articulo
  erpSubrubroCode   String?                             // Código crudo ASUB de Stock_Articulo
  erpBrandCode      String?                             // Código crudo AMAR de Stock_Articulo

  // --- Control de Stock Flexible (Resuelve sueltos vs envasados desde la web) ---
  stock             Int            @default(0)          // Existencia física (viene de AEXIS en Apollo)
  trackStock        Boolean        @default(false)      // false = no frena compra (ej: sueltos o stock condicional); true = frena si stock <= 0
  isBulk            Boolean        @default(false)      // true = producto a granel/suelto (los dueños lo marcan en /admin)

  // --- Control de Publicación (Soberanía Web) ---
  isActive          Boolean        @default(true)       // true = publicado en la tienda (por defecto entran activos); false = oculto

  // --- Clasificación del E-commerce e Imágenes ---
  categoryId        String?                             // Rubro asignado desde el e-commerce
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId     String?                             // Subrubro asignado desde el e-commerce
  subCategory       SubCategory?   @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  brandId           String?                             // Marca asignada desde el e-commerce
  brand             Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images            ProductImage[]                      // Galería de fotos secundarias del producto

  createdAt         DateTime       @default(now())      // Fecha de creación
  updatedAt         DateTime       @updatedAt           // Fecha de última modificación
}

model ProductImage {
  id        String   @id @default(cuid()) // ID de la imagen adicional
  url       String                        // Enlace público de la foto en Supabase Storage
  alt       String?                       // Texto descriptivo para accesibilidad y SEO
  order     Int      @default(0)          // Orden en la galería de fotos (1, 2, 3...)
  
  productId String                        // Producto al que pertenece esta foto
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =========================================================================
// 4. PEDIDOS Y CHECKOUT (Cierre de Venta)
// =========================================================================

model Order {
  id              String       @id @default(cuid()) // Número o código único del pedido
  
  // --- Datos de Contacto y Entrega ---
  customerName    String                            // Nombre y apellido de quien compra
  customerPhone   String                            // Teléfono / WhatsApp del cliente
  deliveryAddress String?                           // Dirección de entrega o "Retiro en local"
  notes           String?                           // Observaciones (ej: "Llamar antes de ir")
  
  // --- Contenido del Pedido y Total ---
  items           Json                              // Copia exacta del carrito al comprar (productos, precio, cant)
  total           Float                             // Importe total final a abonar
  
  // --- Pago y Estados ---
  paymentMethod   String       @default("TRANSFERENCIA") // "TRANSFERENCIA" o "EFECTIVO"
  bankAccountId   String?                           // Cuenta bancaria asignada para la transferencia
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id])
  couponId        String?                           // Cupón de descuento aplicado (si usó uno)
  coupon          Coupon?      @relation(fields: [couponId], references: [id])
  status          String       @default("PENDIENTE") // "PENDIENTE", "PAGADO", "ENTREGADO", "CANCELADO"
  
  // --- Usuario (Opcional, permite comprar como invitado sin cuenta) ---
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])

  createdAt       DateTime     @default(now())      // Fecha y hora en que se creó el pedido
  updatedAt       DateTime     @updatedAt
}

// =========================================================================
// 5. HERRAMIENTAS DE COBRO Y MARKETING (Alias Bancarios y Cupones)
// =========================================================================

model BankAccount {
  id         String   @id @default(cuid()) // ID interno de la cuenta
  bankName   String   @default("")         // Entidad: "Banco Santander", "Mercado Pago", etc.
  holderName String                        // Nombre y apellido del titular
  alias      String                        // Alias para transferir (ej: "HIGIENE.URUGUAY")
  cbu        String                        // CBU o CVU numérico
  active     Boolean  @default(true)       // Si está activa para que el checkout la muestre
  orders     Order[]                       // Pedidos que usaron esta cuenta

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid()) // ID interno del cupón
  code          String    @unique              // Código que escribe el cliente (ej: "DESCUENTO10")
  discountType  String                         // "PERCENTAGE" (ej: 10%) o "FIXED" (ej: $2000)
  discountValue Float                          // Monto o porcentaje a descontar
  expiresAt     DateTime?                      // Fecha de vencimiento (opcional)
  maxUses       Int?                           // Cantidad máxima de usos permitidos (opcional)
  usedCount     Int       @default(0)          // Veces que fue utilizado
  active        Boolean   @default(true)       // Si el cupón está habilitado
  orders        Order[]                        // Pedidos donde se utilizó

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// =========================================================================
// 6. CONFIGURACIONES GENERALES DEL SITIO
// =========================================================================

model SiteConfig {
  id        String   @id @default(cuid()) // ID de la configuración
  key       String   @unique              // Clave (ej: "MIN_ORDER_AMOUNT", "WHATSAPP_NUMBER")
  value     String   @db.Text             // Valor de la configuración

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
